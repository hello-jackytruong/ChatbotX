{
  "name": "chatbotx-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "fix": "ultracite fix --unsafe",
    "check-types": "turbo run check-types --concurrency=2",
    "check-types:cold": "turbo run check-types --concurrency=1",
    "lint": "pnpm check:agent-instructions && pnpm check:invariants && pnpm zalo-personal:source:check && turbo run lint && ultracite check",
    "sync:agent-instructions": "node scripts/sync-agent-instructions.mjs --write",
    "check:agent-instructions": "node scripts/sync-agent-instructions.mjs --check && node scripts/check-skills.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "test": "turbo run test --concurrency=2",
    "test:watch": "vitest",
    "test:coverage": "turbo run test --concurrency=2 -- --coverage",
    "docker:dev": "node scripts/docker/development.mjs",
    "docker:dev:infra": "node scripts/docker/development.mjs up infra",
    "docker:dev:chatbotx": "node scripts/docker/development.mjs up chatbotx",
    "docker:dev:zalo": "node scripts/docker/development.mjs up zalo",
    "docker:dev:full": "node scripts/docker/development.mjs up full",
    "docker:dev:prepare": "node scripts/docker/development.mjs prepare full",
    "docker:dev:status": "node scripts/docker/development.mjs status full",
    "docker:dev:down": "node scripts/docker/development.mjs down",
    "docker:prod:chatbotx": "scripts/deployment/production.sh deploy",
    "docker:prod:zalo": "scripts/docker/zalo-personal/production.sh pull-deploy",
    "docker:prod:full": "scripts/docker/production-full.sh deploy",
    "docker:prod:status": "scripts/docker/production-full.sh status",
    "zalo-personal:install": "node scripts/zalo-personal/run-npm.mjs ci --prefix apps/zalo-personal/backend && node scripts/zalo-personal/run-npm.mjs ci --prefix apps/zalo-personal/frontend --legacy-peer-deps",
    "zalo-personal:dev": "node scripts/zalo-personal/dev.mjs",
    "zalo-personal:dev:infra": "node scripts/zalo-personal/compose.mjs dev-up",
    "zalo-personal:dev:migrate": "node scripts/zalo-personal/migrate-dev.mjs",
    "zalo-personal:dev:down": "node scripts/zalo-personal/compose.mjs dev-down",
    "zalo-personal:build": "node scripts/zalo-personal/run-npm.mjs --prefix apps/zalo-personal/backend run build && node scripts/zalo-personal/run-npm.mjs --prefix apps/zalo-personal/frontend run build",
    "zalo-personal:test:focused": "node scripts/zalo-personal/run-npm.mjs --prefix apps/zalo-personal/backend run test:unit",
    "zalo-personal:test:full": "node scripts/zalo-personal/run-npm.mjs --prefix apps/zalo-personal/backend run test:full",
    "zalo-personal:test:coverage": "node scripts/zalo-personal/run-npm.mjs --prefix apps/zalo-personal/backend run test:coverage",
    "zalo-personal:test:oracle": "node apps/zalo-personal/backend/scripts/contracts/contract-oracle.mjs",
    "zalo-personal:contracts:check": "node scripts/zalo-personal/run-npm.mjs --prefix apps/zalo-personal/backend run contracts:check",
    "zalo-personal:source:check": "node scripts/zalo-personal/check-source-import.mjs",
    "zalo-personal:prod:config": "node scripts/zalo-personal/compose.mjs prod-config",
    "zalo-personal:prod:deploy": "scripts/docker/zalo-personal/production.sh pull-deploy",
    "zalo-personal:prod:status": "scripts/docker/zalo-personal/production.sh status",
    "zalo-personal:prod:logs": "scripts/docker/zalo-personal/production.sh logs",
    "test:docker:zalo-personal": "node scripts/docker/zalo-personal/compose-contract.mjs && bash scripts/docker/zalo-personal/production-selective.test.sh && bash scripts/docker/production-full.test.sh",
    "test:deployment": "node --test scripts/deployment/detect-affected-services.test.mjs && bash scripts/deployment/production-selective.test.sh && bash scripts/docker/zalo-personal/production-selective.test.sh && bash scripts/docker/production-full.test.sh",
    "test:docker:zalo-personal:integration": "bash scripts/docker/zalo-personal/shared-state-integration.test.sh",
    "clean": "pnpm store prune && pnpm dlx rimraf --glob '**/{node_modules,.next,.turbo}'",
    "check:circular": "pnpm dlx madge --circular --extensions ts,tsx --exclude generated {apps/**/src,packages/**/src}",
    "check:unused": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@chatbotx.io/vitest-config": "workspace:*",
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "@types/node": "catalog:",
    "dependency-cruiser": "^17.3.10",
    "knip": "^6.25.0",
    "lefthook": "^2.1.6",
    "tsx": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "ultracite": "7.8.3",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "@types/node": "$@types/node",
    "typescript": "^5",
    "zod": "4.6.7",
    "@codemirror/state": "6.7.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "typescript": "^5",
      "@types/node": "24.x",
      "kysely": "0.28.17",
      "zod": "4.6.7",
      "miniflare>zod": "^3.22.3",
      "google-auth-library": "^10.7.0",
      "@codemirror/state": "6.7.0"
    },
    "updateConfig": {
      "ignoreDependencies": [
        "@types/node",
        "typescript"
      ]
    }
  }
}
