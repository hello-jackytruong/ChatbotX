{
  "name": "@chatbotx.io/zalo-personal-backend",
  "version": "3.4.0",
  "description": "Zalo Sales CRM Backend API",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "dev:gateway": "tsx watch src/gateway.ts",
    "postinstall": "DATABASE_URL=postgresql://build:build@localhost:5432/build prisma generate",
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "start": "node dist/app.js",
    "start:gateway": "node dist/gateway.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:community": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "contracts:runtime": "tsx scripts/contracts/runtime-route-inventory.ts && tsx scripts/contracts/runtime-socket-inventory.ts",
    "contracts:generate": "node scripts/contracts/contract-inventory.mjs && npm run contracts:runtime",
    "contracts:check": "node scripts/contracts/contract-inventory.mjs --check && tsx scripts/contracts/runtime-route-inventory.ts --check && tsx scripts/contracts/runtime-socket-inventory.ts --check",
    "bridge:provision": "tsx scripts/provision-bridge-client.ts",
    "test:contract": "vitest run tests/contracts",
    "test:unit": "vitest run",
    "test:service": "vitest run tests",
    "test:api": "vitest run tests",
    "test:socket": "vitest run tests/aggregate-emit.test.ts tests/security/socket-auth.test.ts tests/integration/socket/socket-wire-contract.test.ts",
    "test:worker": "vitest run tests/friend-sync-cron.test.ts tests/group-scan-worker.test.ts tests/worker-token-passthrough.test.ts",
    "test:frontend": "npm --prefix ../frontend test",
    "test:e2e": "vitest run tests/e2e --passWithNoTests",
    "test:oracle": "node scripts/contracts/contract-oracle.mjs",
    "test:full": "npm run contracts:check && npm run test:community && npm run build && npm --prefix ../frontend test && npm --prefix ../frontend run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@bull-board/api": "^6.21.3",
    "@bull-board/fastify": "^6.21.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.4",
    "firebase-admin": "^14.0.0",
    "image-size": "^2.0.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "sharp": "^0.34.2",
    "socket.io": "^4.8.3",
    "telegram": "^2.26.22",
    "uuid": "^13.0.0",
    "zca-js": "^2.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "nodemon": "^3.1.14",
    "prisma": "^7.5.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
